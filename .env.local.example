# Copy to .env.local. Do not put secrets, tokens, or launch codes here.

# Viewer is always GitLab. API calls go only to the platform gateway.
GATEWAY_ORIGIN=https://gateway.example.com
GATEWAY_API_PREFIX=/api/gitlab
GATEWAY_SESSION_PATH=/api/session

# Parent app origin allowed to embed this viewer (CSP frame-ancestors).
PLATFORM_ORIGIN=https://platform.example.com

# Optional: GitLab web origin for "open on GitLab" style links. Not used for API.
GITLAB_DOMAIN=https://gitlab.example.com

# Dev-only: webpack-dev-server GET /api/session returns this repo. Unset in production.
# VIEWER_DEV_REPO=group/project
# VIEWER_DEV_REF=main
